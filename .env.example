# Copiez ce fichier vers .env :  cp .env.example .env
# .env est ignore par git ET par le contexte Docker (.dockerignore).
#
# Ce fichier ne contient QUE des valeurs factices. Aucun secret reel ne doit
# etre commite : le seul secret du projet (BETTER_AUTH_SECRET) se genere en
# local avec `openssl rand -base64 32` et vit uniquement dans `.env`.

# --- Base de donnees -------------------------------------------------------
# Chemin utilise HORS Docker (drizzle-kit, npm run dev, npm run db:seed).
# Un fichier a la racine du depot, ignore par git.
#
# En Docker, cette valeur n'est PAS lue : docker-compose.yml impose
# file:/data/profilsactifs.db, ou /data est le volume nomme db-data-{dev,prod}.
# Ne pas remettre /data ici : ce repertoire n'existe pas sur l'hote et toutes
# les commandes locales echoueraient sur « Cannot open database because the
# directory does not exist ».
DATABASE_URL=file:./local.db

# --- better-auth -----------------------------------------------------------
# Generez la votre :  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGEZ_MOI_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port expose sur l'hote (le conteneur ecoute toujours sur 3000 en interne)
PORT=3000

# --- Video ---------------------------------------------------------------
# Hebergeur des videos de presentation. Le nom est aussi stocke en base, a
# cote de l'identifiant opaque de chaque video : c'est lui qui dit a qui
# reclamer les octets.
#
#   local     stockage du dispositif, HORS du repertoire web, servi par la
#             route controlee GET /api/videos/{videoId}. Valeur par defaut.
#   peertube  instance video souveraine du Ministere. NON PROVISIONNEE : la
#             mise en oeuvre est factice et se declare indisponible. A
#             utiliser pour eprouver le mode degrade (la fiche profil reste
#             consultable, le lecteur est remplace par un message).
#   embed     lien YouTube / Vimeo. Ne pas mettre ici : c'est un hebergeur
#             d'appoint, allume separement par VIDEO_EMBED_ENABLED.
VIDEO_PROVIDER=local

# Racine du stockage de l'hebergeur local. Par defaut : <dossier de la base>/videos
# (donc /data/videos en Docker). Doit rester HORS de public/.
VIDEO_STORAGE_DIR=

# Hebergement par lien tiers (YouTube, Vimeo). Eteint par defaut : le
# dispositif ne renvoie pas les usagers d'un service public vers une
# plateforme publicitaire. Passer a true reactive le champ « lien » de
# l'espace demandeur et la lecture des fiches deja rattachees a un lien.
VIDEO_EMBED_ENABLED=false

# URL de l'instance PeerTube du Ministere. Sans effet tant que la mise en
# oeuvre est factice : elle n'est jamais contactee, seulement citee dans le
# message d'indisponibilite.
VIDEO_PEERTUBE_URL=

# Transcodage simule de l'hebergeur local, en millisecondes. A 0 (defaut),
# une video deposee est immediatement lisible. Au-dessus, elle reste « en
# cours de traitement » le temps indique : de quoi eprouver le chemin
# asynchrone sans attendre l'instance ministerielle.
VIDEO_LOCAL_PROCESSING_MS=0

# Ancien repertoire de depot (un fichier par profil, <profileId>.<ext>).
# Lu par le seul script `npm run video:migrate`, qui deplace les fichiers
# vers VIDEO_STORAGE_DIR. Par defaut : <dossier de la base>/uploads
VIDEO_UPLOAD_DIR=

# --- Docker (optionnel) --------------------------------------------------
# Rejoue les migrations Drizzle depuis l'entrypoint plutot que depuis
# src/instrumentation.ts. Laisser vide en temps normal : l'image standalone
# joue deja les migrations au demarrage du serveur.
RUN_MIGRATIONS_ON_BOOT=
